# =============================================================================
# DinePulse - Multi-Site Environment Variables Configuration
# =============================================================================
# DinePulse runs three distinct surfaces from a single unified codebase:
#   - Customer (guest ordering, payments, tracking) -> SITE=customer
#   - Kitchen (KDS live order tickets)             -> SITE=kitchen
#   - Manager (admin console, menu CRUD, analytics)  -> SITE=manager
#   - Monolith (legacy local full-stack dev)        -> SITE=all
#
# When deploying to Vercel, create 3 separate projects pointing to the same repo
# and configure each project's environment variables as specified below.
# See docs/DEPLOY.md for complete deployment instructions.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SHARED CONFIGURATION (Required for ALL 3 Sites)
# -----------------------------------------------------------------------------

# PostgreSQL Connection String (Drizzle ORM)
# Use transaction pooler (port 6543) with ?pgbouncer=true on serverless (Vercel):
# e.g. postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dinepulse

# Staff Session Auth Secret (min 32 chars, cannot be default or placeholder)
# MUST BE IDENTICAL across all three sites for demo and cross-site token validation!
# Generate with: openssl rand -base64 48
SESSION_SECRET=at-least-32-characters-random-secret-for-signing-cookies

# Demo Mode ("true" or "false", default: "false")
# Controls demo showcases, mock credentials, and simulation tools.
DEMO_MODE=true

# Supabase Realtime Configuration (Live Order Stepper & Kitchen KDS)
# Required for live WebSocket updates between Guest, Kitchen, and Manager.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder_anon_key
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key

# Optional Site Name (Branding template in HTML metadata)
NEXT_PUBLIC_SITE_NAME=DinePulse


# -----------------------------------------------------------------------------
# 2. CUSTOMER SITE CONFIGURATION (SITE=customer)
# Deployed at e.g. https://order.yourdomain.com
# -----------------------------------------------------------------------------

# Target Site Identifier (Must be exactly "customer")
SITE=customer

# Customer Site Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay Payment Gateway Credentials (Required in production when DEMO_MODE=false)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Demo Cross-Site Navigation & Reset (Required when DEMO_MODE=true on customer)
# Bearer secret for POST /api/demo/reset
DEMO_RESET_SECRET=demo-reset-secret-at-least-32-characters-long
# URLs for Kitchen and Manager sites (used on /demo page for iframe embedding & links)
NEXT_PUBLIC_KITCHEN_SITE_URL=http://localhost:3001
NEXT_PUBLIC_MANAGER_SITE_URL=http://localhost:3002


# -----------------------------------------------------------------------------
# 3. KITCHEN SITE CONFIGURATION (SITE=kitchen)
# Deployed at e.g. https://kitchen.yourdomain.com
# -----------------------------------------------------------------------------

# Target Site Identifier (Must be exactly "kitchen")
# SITE=kitchen

# Kitchen Site Public URL
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# Allowed Frame Ancestors (Origins allowed to embed this site in an iframe)
# Required when DEMO_MODE=true to allow embedding inside customer's /demo page.
# FRAME_ANCESTORS=http://localhost:3000


# -----------------------------------------------------------------------------
# 4. MANAGER SITE CONFIGURATION (SITE=manager)
# Deployed at e.g. https://manager.yourdomain.com
# -----------------------------------------------------------------------------

# Target Site Identifier (Must be exactly "manager")
# SITE=manager

# Manager Site Public URL
# NEXT_PUBLIC_APP_URL=http://localhost:3002

# Allowed Frame Ancestors (Origins allowed to embed this site in an iframe)
# Required when DEMO_MODE=true to allow embedding inside customer's /demo page.
# FRAME_ANCESTORS=http://localhost:3000


# -----------------------------------------------------------------------------
# 5. OPTIONAL SEED & CRON CREDENTIALS
# -----------------------------------------------------------------------------

# Custom Staff Passwords during db:seed (Generated randomly outside DEMO_MODE if omitted)
# SEED_KITCHEN_PASSWORD=
# SEED_MANAGER_PASSWORD=

# Vercel Cron Secret (Matches Authorization Bearer token sent by Vercel Cron)
# CRON_SECRET=
