# =============================================================================
# DinePulse - Demo Restaurant Ordering System by Intallo (intallo.in)
# Environment Variables Specification
# =============================================================================

# Public App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Connection String (Drizzle ORM)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[mode]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dinepulse

# Razorpay Test Mode Credentials
# Required for guest order payment checkout integration & server verification
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Supabase Realtime Configuration (Live Order Stepper & Kitchen KDS)
# Required for live WebSocket status updates between Guest and Kitchen
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder_anon_key
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key

# Staff Session Auth Secret
SESSION_SECRET=dinepulse_super_secret_staff_session_key_2026
