# =============================================================================
# DinePulse - Multi-Site Environment Variables Configuration
# =============================================================================
# DinePulse runs three distinct surfaces from a single unified codebase:
#   - Customer (guest ordering, payments, live order tracking) -> SITE=customer
#   - Kitchen (KDS live kitchen display system)               -> SITE=kitchen
#   - Manager (admin console, menu management, analytics)     -> SITE=manager
#   - All / Dev (monolith local development)                  -> SITE=all
#
# When deploying to Vercel, create 3 separate projects pointing to this repo
# and configure each project with ONLY the environment variables listed in its block.
# =============================================================================


# =============================================================================
# SITE 1: CUSTOMER SITE (SITE=customer)
# Deployed at e.g. https://order.yourdomain.com
# =============================================================================

# Site identifier
SITE=customer

# Customer site canonical public URL
APP_URL=https://order.yourdomain.com

# PostgreSQL connection string (Supabase transaction pooler port 6543 on Vercel)
DATABASE_URL=postgresql://postgres:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Staff session auth secret (min 32 characters; must match across all 3 sites)
SESSION_SECRET=replace-with-at-least-32-characters-cryptographically-random-secret

# Supabase Realtime credentials (required for live order sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Payments Mode: "online" (default) or "counter_only"
# When set to "counter_only", customers pay at counter only and no Razorpay keys are required.
PAYMENTS_MODE=online
# Dynamic UPI QR is disabled by default; enable only after Razorpay activates QR support.
ENABLE_UPI_QR=false

# Razorpay credentials (REQUIRED in production when PAYMENTS_MODE=online)
# Not required when PAYMENTS_MODE=counter_only.
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_key_secret
# Note: RAZORPAY_WEBHOOK_SECRET is the HMAC signing secret configured in Razorpay Dashboard (Settings -> Webhooks), NOT the webhook endpoint URL.
RAZORPAY_WEBHOOK_SECRET=your_actual_webhook_signing_secret

# Optional branding name
NEXT_PUBLIC_SITE_NAME=DinePulse


# =============================================================================
# SITE 2: KITCHEN DISPLAY SYSTEM (SITE=kitchen)
# Deployed at e.g. https://kitchen.yourdomain.com
# Note: The kitchen site NEVER requires Razorpay payment variables.
# =============================================================================

# Site identifier
SITE=kitchen

# Kitchen site canonical public URL
APP_URL=https://kitchen.yourdomain.com

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Staff session auth secret (min 32 characters; must match across all 3 sites)
SESSION_SECRET=replace-with-at-least-32-characters-cryptographically-random-secret

# Supabase Realtime credentials (required for live order ticket updates)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional branding name
NEXT_PUBLIC_SITE_NAME=DinePulse


# =============================================================================
# SITE 3: MANAGER / ADMIN CONSOLE (SITE=manager)
# Deployed at e.g. https://manager.yourdomain.com
# Note: The manager site NEVER requires Razorpay payment variables.
# =============================================================================

# Site identifier
SITE=manager

# Manager site canonical public URL
APP_URL=https://manager.yourdomain.com

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Staff session auth secret (min 32 characters; must match across all 3 sites)
SESSION_SECRET=replace-with-at-least-32-characters-cryptographically-random-secret

# Supabase Realtime credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional branding name
NEXT_PUBLIC_SITE_NAME=DinePulse


# =============================================================================
# LOCAL DEVELOPMENT (SITE=all)
# =============================================================================
# For single-process local development serving all surfaces on localhost:3000:
#
# SITE=all
# APP_URL=http://localhost:3000
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dinepulse
# SESSION_SECRET=development-session-secret-at-least-32-characters-long
# NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder_anon_key
# SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key
# PAYMENTS_MODE=online
# RAZORPAY_KEY_ID=rzp_test_placeholder
# RAZORPAY_KEY_SECRET=placeholder_secret
# RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
#
# Non-production local development flags (strictly rejected in production):
# ALLOW_TEST_PAYMENT_SIMULATION=true
# DEV_TABLE_TOKEN=dev-table-session-token
# ENABLE_DEV_TABLE_LAUNCHER=true
# ALLOW_LOCAL_DEMO_UPLOADS=true
# SEED_KITCHEN_PASSWORD=optional_kitchen_seed_password
# SEED_MANAGER_PASSWORD=optional_manager_seed_password
