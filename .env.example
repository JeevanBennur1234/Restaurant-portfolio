# =============================================================================
# DinePulse - Demo Restaurant Ordering System by Intallo (intallo.in)
# Environment Variables Specification
# =============================================================================

# Public App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Connection String (Drizzle ORM)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[mode]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dinepulse

# Razorpay Test Mode Credentials
# Required for guest order payment checkout integration & server verification
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Supabase Realtime Configuration (Live Order Stepper & Kitchen KDS)
# Required for live WebSocket status updates between Guest and Kitchen
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder_anon_key
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key

# Staff Session Auth Secret (min 32 chars, cannot be default or contain "placeholder" in production)
SESSION_SECRET=generate-with: openssl rand -base64 48

# Demo Mode (Allowed values: true | false. Defaults to false)
DEMO_MODE=false

# Demo Reset Secret (Required to authorize demo state reset when DEMO_MODE is true)
DEMO_RESET_SECRET=generate-with: openssl rand -base64 48

# Optional Seed Passwords (defaults to kitchen123/manager123 in DEMO_MODE; generated randomly outside DEMO_MODE if unset)
# SEED_KITCHEN_PASSWORD=
# SEED_MANAGER_PASSWORD=
