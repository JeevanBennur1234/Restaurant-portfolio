{
  "name": "dinepulse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:customer": "cross-env SITE=customer next dev -p 3000",
    "dev:kitchen": "cross-env SITE=kitchen next dev -p 3001",
    "dev:manager": "cross-env SITE=manager next dev -p 3002",
    "dev:sites": "concurrently -k -n customer,kitchen,manager \"npm:dev:customer\" \"npm:dev:kitchen\" \"npm:dev:manager\"",
    "build": "next build",
    "build:customer": "cross-env SITE=customer next build",
    "build:kitchen": "cross-env SITE=kitchen next build",
    "build:manager": "cross-env SITE=manager next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:migrate-images": "tsx scripts/migrate-data-urls.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "check-images": "tsx scripts/check-images.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "lenis": "^1.3.26",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
